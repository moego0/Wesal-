// Wisal (وِصال) — pharmacist medication follow-up platform.
//
// Two conventions used throughout, both deliberate:
//
//   1. Audit-ish columns (`createdByUserId`, `actorUserId`, `verifiedByUserId`,
//      `resolvedByUserId`, …) are plain strings, NOT Prisma relations. They must
//      survive deletion of the user they name, and an audit trail that cascades
//      is not an audit trail.
//
//   2. Declared relations are reserved for navigations the application actually
//      performs. Everything else is a scalar FK-ish column with an index.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved the connection URL out of the schema and into
// `prisma.config.ts`. The runtime client gets its connection from a driver
// adapter instead — see src/server/db.ts.
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────── enums ────────────────────────────────

enum Locale {
  AR_EG
  EN
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum PharmacyRole {
  PHARMACY_ADMIN
  PHARMACIST
  ASSISTANT
  VIEWER
}

enum PatientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ConsentType {
  DATA_PROCESSING
  WHATSAPP_MESSAGING
  RESEARCH
}

enum ConsentCaptureMethod {
  PAPER_SIGNED
  VERBAL_ATTESTED
  DIGITAL
}

enum MedicationStatus {
  ACTIVE
  ON_HOLD
  DISCONTINUED
  COMPLETED
}

enum ScheduleStatus {
  DRAFT
  ACTIVE
  PAUSED
  DISCONTINUED
  COMPLETED
}

enum ScheduleMode {
  FIXED_TIMES_OF_DAY
  INTERVAL_HOURS
  PRN
}

enum ScheduleChangeKind {
  CREATED
  TIMES_CHANGED
  MODE_CHANGED
  DAYS_CHANGED
  PAUSED
  RESUMED
  DISCONTINUED
  COMPLETED
  END_DATE_CHANGED
  TZ_CHANGED
  DOSE_CHANGED
}

/// What happened to the *message*. Orthogonal to ResponseState — keeping these
/// two fields separate is what stops a late `read` receipt from clobbering an
/// answer the patient already gave.
enum DeliveryState {
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  /// Never sent, because it became too late to be worth sending. NOT the same
  /// as NO_RESPONSE — merging them would blame the patient for our downtime.
  EXPIRED
  CANCELLED
  /// Moved to a different time by a schedule edit (vs CANCELLED: no longer
  /// clinically indicated). Distinct because they read differently in reports.
  SUPERSEDED
  SKIPPED
}

/// What the *patient said*. Deliberately does NOT contain NO_RESPONSE: that is
/// the absence of an answer, recorded as a derived disposition on the event, so
/// a late reply can coexist with it instead of overwriting it.
enum ResponseState {
  NONE
  TAKEN
  TAKEN_LATE
  MISSED
  REMIND_LATER
  PROBLEM
  UNATTRIBUTED
}

enum ReminderKind {
  SCHEDULED_DOSE
  SNOOZE
  REFILL_PROMPT
  ADHOC
}

enum ResponseChannel {
  WHATSAPP_BUTTON
  WHATSAPP_LIST
  WHATSAPP_TEXT
  PHARMACIST_ENTRY
}

/// Single-valued on purpose. No code path constructs this with any other value,
/// and a CHECK constraint in the raw migration enforces that a PATIENT_REPORTED
/// row can never be isVerified=true.
enum ResponseSource {
  PATIENT_REPORTED
}

enum VerificationState {
  UNVERIFIED
  PHARMACIST_CONFIRMED
  PHARMACIST_CORRECTED
}

enum CaseOrigin {
  RULE_ALERT
  PROBLEM_RESPONSE
  MANUAL
  UNSOLICITED_MESSAGE
  REFILL
  PATIENT_REQUEST
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_PATIENT
  RESOLVED
  CLOSED_NO_ACTION
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InterventionType {
  PHONE_CALL
  WHATSAPP_MESSAGE
  DOSE_CHANGE
  REFILL_SET
  PATIENT_EDUCATION
  REFERRAL
  NO_ACTION
}

enum InterventionOutcome {
  REACHED
  NO_ANSWER
  LEFT_MESSAGE
  PATIENT_CONFIRMED
  PATIENT_DENIED
  UNABLE_TO_CONTACT
}

enum RefillStatus {
  ESTIMATED
  DUE
  REQUESTED
  SCHEDULED
  DISPENSED
  CANCELLED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED_AUTO
  RESOLVED_MANUAL
  SUPPRESSED
}

enum Severity {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DispatchStatus {
  ATTEMPTING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  /// Reconciler gave up without a definitive answer.
  UNKNOWN
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD
}

enum InboundStatus {
  RECEIVED
  ROUTED
  UNROUTED
  FAILED
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

enum ActorType {
  USER
  SYSTEM
  PATIENT
  INTEGRATION
}

enum MessageIntent {
  STOP
  PROBLEM
  REFILL
  TAKEN
  MISSED
  REMIND_LATER
  OTHER
}

// ──────────────────────────── tenancy & identity ────────────────────────────

model Pharmacy {
  id              String   @id @default(cuid())
  name            String
  /// IANA identifier only — never a Windows timezone name.
  timeZone        String   @default("Africa/Cairo")
  defaultLocale   Locale   @default(AR_EG)
  /// Local wall-clock "HH:mm". Suppresses outbound during these hours.
  quietHoursStart String   @default("21:00")
  quietHoursEnd   String   @default("07:00")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships PharmacyMembership[]
  channels    MessagingChannel[]
  patients    Patient[]
  rules       RuleDefinition[]
}

/// A global identity. Pharmacy access is a membership join, so one pharmacist
/// working at two pharmacies has a single account.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phoneE164    String?
  fullName     String
  locale       Locale     @default(AR_EG)
  status       UserStatus @default(ACTIVE)
  passwordHash String?
  /// scrypt parameters actually used, so hashes can be upgraded over time
  /// without invalidating existing logins.
  passwordAlgo String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships PharmacyMembership[]
  sessions    Session[]
}

model PharmacyMembership {
  id         String       @id @default(cuid())
  userId     String
  pharmacyId String
  role       PharmacyRole
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
  @@index([pharmacyId, role, active])
}

/// Server-side session. Stored in the DB (not a JWT) so logout and role changes
/// take effect immediately rather than at token expiry.
model Session {
  id           String   @id @default(cuid())
  /// SHA-256 of the opaque cookie value. The raw token is never persisted.
  tokenHash    String   @unique
  userId       String
  activePharmacyId String?
  expiresAt    DateTime
  revokedAt    DateTime?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Maps an inbound webhook to a pharmacy. Without this, an inbound message
/// cannot be routed to a tenant at all.
model MessagingChannel {
  id                    String   @id @default(cuid())
  pharmacyId            String
  provider              String
  /// Meta's `phone_number_id`. Also the unique webhook routing key.
  providerPhoneNumberId String   @unique
  displayPhoneE164      String
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
}

// ──────────────────────────────── patients ────────────────────────────────

model Patient {
  id              String        @id @default(cuid())
  pharmacyId      String
  fullName        String
  /// Normalized E.164. Indexed but deliberately NOT unique — shared family
  /// handsets are common, and a unique constraint would silently block real
  /// enrollments. Consequence: reminder copy must name the patient.
  phoneE164       String
  phoneRaw        String?
  preferredLocale Locale        @default(AR_EG)
  /// Default for new schedules only. Each schedule carries its own timezone,
  /// because changing this must not silently shift an existing regimen.
  timeZone        String        @default("Africa/Cairo")
  dateOfBirth     DateTime?     @db.Date
  gender          Gender?
  status          PatientStatus @default(ACTIVE)
  messagingOptOutAt DateTime?
  /// Drives the 24-hour customer service window calculation.
  lastInboundAtUtc  DateTime?
  lastOutboundAtUtc DateTime?
  careNotes       String?
  /// Optional external reference (file number). Never the primary key.
  externalRef     String?
  createdAt       DateTime      @default(now())
  createdByUserId String?

  pharmacy     Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  consents     ConsentRecord[]
  medications  MedicationRecord[]
  schedules    MedicationSchedule[]
  events       ReminderEvent[]
  responses    PatientResponse[]
  cases        FollowUpCase[]
  interventions PharmacistIntervention[]
  refills      RefillRecord[]
  messages     PatientMessage[]

  @@index([pharmacyId, phoneE164])
  @@index([pharmacyId, status])
  @@index([status, timeZone])
}

model ConsentRecord {
  id              String               @id @default(cuid())
  pharmacyId      String
  patientId       String
  consentType     ConsentType
  granted         Boolean
  grantedAt       DateTime?
  grantedByUserId String?
  captureMethod   ConsentCaptureMethod
  /// Storage key of the scanned form, when captureMethod is PAPER_SIGNED.
  evidenceRef     String?
  revokedAt       DateTime?
  revokedReason   String?
  expiresAt       DateTime?
  notes           String?
  createdAt       DateTime             @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, consentType, grantedAt])
  @@index([pharmacyId, consentType, granted])
}

// ─────────────────────────── medications & schedules ───────────────────────────

model MedicationRecord {
  id                 String           @id @default(cuid())
  pharmacyId         String
  patientId          String
  medicationNameText String
  /// ATC or other code, where reliably available.
  medicationCode     String?
  dosageForm         String?
  strengthText       String?
  doseAmountText     String?
  instructionsTextAr String?
  instructionsTextEn String?
  prescriberText     String?
  indicationText     String?
  status             MedicationStatus @default(ACTIVE)
  startedOn          DateTime         @db.Date
  discontinuedOn     DateTime?        @db.Date
  discontinueReason  String?
  isChronic          Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdByUserId    String?

  patient      Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  schedules    MedicationSchedule[]
  events       ReminderEvent[]
  refills      RefillRecord[]
  interventions PharmacistIntervention[]
  cases        FollowUpCase[]

  @@index([pharmacyId, patientId, status])
  @@index([patientId, status])
}

model MedicationSchedule {
  id         String         @id @default(cuid())
  pharmacyId String
  patientId  String
  medicationId String
  status     ScheduleStatus @default(ACTIVE)
  mode       ScheduleMode

  /// Local wall-clock "HH:mm" values, interpreted in `timeZone`. Never stored
  /// as UTC instants — 08:00 must stay 08:00 across a DST transition.
  timesOfDay String[]
  /// 0=Sunday. Empty array means every day.
  daysOfWeek Int[]
  intervalHours Int?
  anchorAtUtc   DateTime?

  /// IANA, authoritative for materialization. Snapshotted per schedule.
  timeZone  String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  durationDays Int?

  /// Override for the computed late-send window. Null = use the clamp.
  lateWindowMinutes     Int?
  responseWindowMinutes Int?
  /// Minutes after the dose time during which "taken" still counts as on-time.
  lateResponseMinutes   Int  @default(15)
  snoozeDefaultMinutes  Int  @default(30)
  maxSnoozesPerDose     Int  @default(2)

  /// Bumped on EVERY mutation. A dispatch compares the event's snapshot against
  /// this to detect that the schedule changed while the send was in flight.
  revision              Int      @default(1)
  materializedThroughUtc DateTime?

  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication MedicationRecord  @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  revisions  MedicationScheduleRevision[]
  events     ReminderEvent[]

  @@index([pharmacyId, status])
  @@index([status, materializedThroughUtc])
  @@index([patientId, status])
}

/// Full spec at each revision. Pairs with AuditEvent: this gives exact
/// reconstruction, AuditEvent gives cross-entity queryability. Both are written
/// in the same transaction as the change.
model MedicationScheduleRevision {
  id              String             @id @default(cuid())
  scheduleId      String
  revision        Int
  snapshot        Json
  changeKind      ScheduleChangeKind
  changedByUserId String
  changedAtUtc    DateTime           @default(now())
  reason          String?

  schedule MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, revision])
  @@index([scheduleId, changedAtUtc])
}

// ──────────────────────────── reminders & delivery ────────────────────────────

model ReminderEvent {
  id         String @id @default(cuid())
  pharmacyId String
  patientId  String
  medicationId String
  scheduleId String
  /// The schedule revision this row was materialized from. Mismatch at send
  /// time means the schedule moved under us.
  scheduleRevisionSnapshot Int

  kind          ReminderKind @default(SCHEDULED_DOSE)
  parentEventId String?

  /// The resolved UTC instant, computed once at materialization by a real tz
  /// library.
  doseAtUtc     DateTime
  /// Local date + time at the dose, for day-boundary reporting and display.
  doseLocalDate DateTime @db.Date
  doseLocalTime String
  /// Set when DST forced the dose off its nominal wall-clock time.
  dstAdjusted   Boolean  @default(false)

  responseWindowEndsAtUtc DateTime

  deliveryState DeliveryState @default(SCHEDULED)
  responseState ResponseState @default(NONE)

  activeDispatchId String?
  attemptCount     Int       @default(0)
  lastAttemptAtUtc DateTime?
  firstSentAtUtc   DateTime?
  /// Set by the no-response settlement sweep. `responseState` stays NONE, so a
  /// late reply coexists with the settlement record instead of erasing it.
  settledAtUtc     DateTime?
  lateReopen       Boolean   @default(false)

  /// False for snooze children (the dose is the scoring unit, not the reminder)
  /// and for events that were never deliverable.
  countedForAdherence Boolean @default(true)
  /// Gates the rule engine. A stale or ambiguous response is still stored for
  /// the patient's history but excluded from the fact book, so it can neither
  /// manufacture nor mask an alert.
  ruleEligible        Boolean @default(true)
  staleFlag           Boolean @default(false)

  snoozeCount Int @default(0)

  cancelReason                 String?
  supersededByScheduleRevision Int?
  skipReason                   String?

  materializedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient    Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication MedicationRecord  @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  schedule   MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  parent   ReminderEvent?  @relation("SnoozeChain", fields: [parentEventId], references: [id])
  children ReminderEvent[] @relation("SnoozeChain")

  dispatches ReminderDispatch[]
  responses  PatientResponse[]

  /// Materialization idempotency: a dose slot is identified by its instant.
  @@unique([scheduleId, doseAtUtc])
  @@index([deliveryState, doseAtUtc])
  @@index([deliveryState, updatedAt])
  @@index([responseState, responseWindowEndsAtUtc])
  @@index([pharmacyId, doseAtUtc])
  @@index([patientId, doseAtUtc])
}

model ReminderDispatch {
  /// Doubles as the BullMQ jobId AND the WhatsApp `biz_opaque_callback_data`,
  /// so a delivery receipt can be traced back to this exact attempt.
  id              String @id
  pharmacyId      String
  reminderEventId String
  attemptNo       Int
  provider        String
  providerMessageId String?
  providerTemplateName String?
  toPhoneE164     String

  status         DispatchStatus @default(ATTEMPTING)
  requestPayload Json?
  responsePayload Json?
  errorCode      String?
  errorMessage   String?
  errorRetryable Boolean?

  acceptedAtUtc  DateTime?
  deliveredAtUtc DateTime?
  readAtUtc      DateTime?
  failedAtUtc    DateTime?
  /// If a worker dies mid-send the row is resolved by the reconciler after this.
  reconcileDeadlineUtc DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminderEvent ReminderEvent @relation(fields: [reminderEventId], references: [id], onDelete: Cascade)

  @@unique([reminderEventId, attemptNo])
  @@index([status, reconcileDeadlineUtc])
  @@index([providerMessageId])
}

// ──────────────────────────────── responses ────────────────────────────────

/// Every inbound webhook, persisted raw before any processing. Returning 200
/// fast and processing asynchronously is what keeps Meta from retrying.
model InboundMessage {
  id                String        @id @default(cuid())
  /// Null when the receiving channel could not be resolved to a pharmacy.
  pharmacyId        String?
  /// Meta's wamid. Unique, so a webhook redelivery is a no-op.
  providerMessageId String        @unique
  fromPhoneE164     String
  toPhoneE164       String
  channelId         String?
  type              String
  /// The attribution key for template replies: the wamid the patient tapped.
  contextMessageId  String?
  rawPayload        Json
  receivedAtUtc     DateTime
  processedAtUtc    DateTime?
  processingStatus  InboundStatus @default(RECEIVED)
  processingError   String?
  routedPatientId   String?
  routedEventId     String?

  responses PatientResponse[]

  @@index([fromPhoneE164, receivedAtUtc])
  @@index([processingStatus, receivedAtUtc])
  @@index([contextMessageId])
}

model PatientResponse {
  id              String  @id @default(cuid())
  pharmacyId      String
  patientId       String
  /// Null when the reply could not be tied to a specific dose.
  reminderEventId String?
  inboundMessageId String?
  /// wamid of this reply. Unique, so Meta's webhook redelivery cannot
  /// double-record. Nullable — Postgres permits many NULLs in a unique index.
  rawMessageId    String? @unique

  channel ResponseChannel
  answer  ResponseState?
  freeText String?
  intentClassified MessageIntent?

  // ── patient-reported discipline ──
  source            ResponseSource    @default(PATIENT_REPORTED)
  /// Always false on any inbound path. A pharmacist correction is a SEPARATE
  /// row with verificationState=PHARMACIST_CORRECTED; it never retroactively
  /// makes the patient's own report "verified".
  isVerified        Boolean           @default(false)
  verificationState VerificationState @default(UNVERIFIED)
  verifiedByUserId  String?
  verifiedAtUtc     DateTime?

  // ── application bookkeeping ──
  /// False for every response after the first on the same event.
  applied            Boolean @default(true)
  appliedToAdherence Boolean @default(true)
  /// Excluded from the rule engine when stale, ambiguous, or a duplicate.
  ruleEligible       Boolean @default(true)
  staleFlag          Boolean @default(false)
  supersedesResponseId String?
  /// Only when the patient explicitly states a time.
  patientClaimedAtUtc DateTime?

  receivedAtUtc DateTime
  recordedAtUtc DateTime @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reminderEvent ReminderEvent? @relation(fields: [reminderEventId], references: [id])
  inboundMessage InboundMessage? @relation(fields: [inboundMessageId], references: [id])

  // NOTE: deliberately NO unique constraint on reminderEventId. Adding one is a
  // tempting "cleanup" that makes a duplicate tap throw a constraint violation,
  // which surfaces to Meta as a 500 and produces an infinite webhook retry
  // loop. Duplicates must be storable and ignorable, not impossible.
  @@index([reminderEventId])
  @@index([patientId, receivedAtUtc])
  @@index([pharmacyId, applied, receivedAtUtc])
}

/// Inbound that is not a dose response: free text, media, voice notes,
/// location. Stored rather than interpreted.
model PatientMessage {
  id         String        @id @default(cuid())
  pharmacyId String
  patientId  String
  inboundMessageId String? @unique
  intent     MessageIntent?
  bodyText   String?
  mediaType  String?
  mediaRef   String?
  handledByUserId String?
  handledAtUtc DateTime?
  createdAt  DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, handledAtUtc])
  @@index([patientId, createdAt])
}

// ──────────────────────────── follow-up & interventions ────────────────────────────

model FollowUpCase {
  id         String @id @default(cuid())
  pharmacyId String
  patientId  String
  medicationId String?
  /// Plain scalar, not a relation: Alert also points at the case, and a real
  /// FK in both directions would be circular.
  openedByAlertId String? @unique
  openedByUserId  String?

  origin   CaseOrigin
  priority Priority @default(NORMAL)
  status   CaseStatus @default(OPEN)

  titleAr String?
  titleEn String?
  summary String?

  assigneeUserId String?
  openedAtUtc    DateTime  @default(now())
  dueByUtc       DateTime?
  firstActionAtUtc DateTime?
  resolvedAtUtc  DateTime?
  resolutionCode String?
  resolutionNotes String?
  tags           String[]

  patient       Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication    MedicationRecord?       @relation(fields: [medicationId], references: [id])
  interventions PharmacistIntervention[]
  alerts        Alert[]

  @@index([pharmacyId, status, priority, openedAtUtc])
  @@index([assigneeUserId, status])
  @@index([patientId, status])
}

model PharmacistIntervention {
  id         String @id @default(cuid())
  pharmacyId String
  caseId     String?
  patientId  String
  medicationId String?
  interventionType InterventionType
  outcome          InterventionOutcome
  notes            String?
  performedByUserId String
  performedAtUtc   DateTime @default(now())
  durationSeconds  Int?

  case      FollowUpCase?     @relation(fields: [caseId], references: [id])
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication MedicationRecord? @relation(fields: [medicationId], references: [id])

  @@index([patientId, performedAtUtc])
  @@index([caseId])
  @@index([pharmacyId, performedAtUtc])
}

model RefillRecord {
  id         String @id @default(cuid())
  pharmacyId String
  patientId  String
  medicationId String
  status     RefillStatus @default(ESTIMATED)

  lastDispensedOn DateTime? @db.Date
  daysSupply      Int?
  unitsDispensed  Decimal?  @db.Decimal(12, 3)
  /// Derived: lastDispensedOn + daysSupply. Deliberately NOT adjusted by
  /// patient-reported adherence — that would compound two unreliable numbers.
  expectedRunOutOn DateTime? @db.Date
  refillDueOn      DateTime? @db.Date
  refillLeadDays   Int       @default(5)

  requestedAtUtc DateTime?
  remindedAtUtc  DateTime?
  dispensedAtUtc DateTime?
  notes          String?

  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication MedicationRecord @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, status, refillDueOn])
  @@index([patientId, medicationId])
}

// ──────────────────────────────── rules & alerts ────────────────────────────────

/// A fixed catalog of parameterized shapes, not a general expression language.
/// `compiledCondition` is an OUTPUT written for auditability — the executable
/// predicate is derived from ruleKey+params in code, so a rule definition
/// cannot express anything the catalog does not already implement.
model RuleDefinition {
  id         String  @id @default(cuid())
  /// Null means a system default template, inheritable by any pharmacy.
  pharmacyId String?
  ruleKey    String
  version    Int     @default(1)
  nameAr     String
  nameEn     String
  descriptionAr String
  descriptionEn String
  enabled        Boolean  @default(true)
  severity       Severity
  params         Json
  scope          Json
  triggerType    String
  cronExpression String?
  compiledCondition Json
  dedupeKeyTemplate String
  cooldownHours     Int     @default(24)
  autoResolveRuleKey String?
  actions            Json
  isSystemDefault    Boolean @default(false)
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, ruleKey, version])
  @@index([pharmacyId, enabled])
}

model Alert {
  id         String @id @default(cuid())
  patientId  String
  pharmacyId String
  medicationId String?
  ruleKey     String
  ruleVersion Int
  /// e.g. "CONSECUTIVE_MISSES|pat_abc|med_xyz". A partial unique index
  /// (see the raw migration) permits at most one OPEN/ACKNOWLEDGED alert per
  /// key — enforced in Postgres because a read-then-insert races.
  dedupeKey   String
  severity    Severity
  status      AlertStatus @default(OPEN)

  titleAr  String
  titleEn  String
  detailAr String
  detailEn String
  /// Triggering ReminderEvent ids and the computed fact values that satisfied
  /// the predicate — the transparency requirement made concrete.
  evidence Json

  openedAtUtc     DateTime  @default(now())
  lastSeenAtUtc   DateTime  @default(now())
  occurrenceCount Int       @default(1)
  reopenCount     Int       @default(0)
  suppressUntilUtc DateTime?
  resolvedAtUtc   DateTime?
  resolvedByUserId String?
  resolutionNote  String?
  caseId          String?

  case  FollowUpCase? @relation(fields: [caseId], references: [id])
  events AlertEvent[]

  @@index([pharmacyId, status, severity, openedAtUtc])
  @@index([patientId, openedAtUtc])
  @@index([caseId])
}

model AlertEvent {
  id      String   @id @default(cuid())
  alertId String
  eventType String
  atUtc     DateTime @default(now())
  actorUserId String?
  meta      Json?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, atUtc])
}

// ──────────────────────────── messaging configuration ────────────────────────────

model WhatsAppTemplate {
  id            String         @id @default(cuid())
  pharmacyId    String?
  providerName  String
  languageCode  String
  category      String
  status        TemplateStatus @default(UNKNOWN)
  components    Json
  variablesSchema Json
  lastSyncedAtUtc DateTime?

  /// Arabic and English are separately approved by Meta; one can be rejected
  /// while the other is live.
  @@unique([providerName, languageCode])
  @@index([pharmacyId, status])
}

// ──────────────────────────── infrastructure ────────────────────────────

/// Append-only. UPDATE and DELETE are revoked for the app role in the raw
/// migration. Written in the SAME transaction as the change it describes.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  pharmacyId String
  actorType  ActorType
  actorUserId String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  ipAddress  String?
  occurredAtUtc DateTime @default(now())

  @@index([entityType, entityId, occurredAtUtc])
  @@index([pharmacyId, occurredAtUtc])
  @@index([actorUserId, occurredAtUtc])
}

/// Transactional outbox. Lets a state change and its downstream side effects
/// (rule evaluation, live UI update) commit atomically without a distributed
/// transaction.
model OutboxEvent {
  id            String       @id @default(cuid())
  pharmacyId    String?
  topic         String
  aggregateType String
  aggregateId   String
  payload       Json
  dedupeKey     String       @unique
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAtUtc DateTime    @default(now())
  publishedAtUtc DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAtUtc])
}

/// The only thing that detects the silent total failure where Redis is flushed,
/// every repeatable job registration vanishes, and no reminders go out with
/// nothing logged.
model SweepHeartbeat {
  id             String   @id @default(cuid())
  sweepName      String   @unique
  lastRunAtUtc   DateTime
  lastDurationMs Int
  hostId         String
  lastError      String?
}
