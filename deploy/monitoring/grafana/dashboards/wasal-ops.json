{
  "uid": "wasal-ops",
  "title": "Wisal — Operations",
  "description": "What the reminder machinery is doing, and what has silently stopped. Every panel answers a question that is otherwise only reachable by opening psql on the server.",
  "tags": ["wisal", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sweeps overdue",
      "description": "A sweep past its watchdog threshold. This is the number that means reminders have stopped going out, and the failure it describes raises no error anywhere in the application.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(wasal_sweep_stale{sweep!=\"heartbeat\"})",
          "instant": true,
          "legendFormat": "overdue"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replies no pharmacy is seeing",
      "description": "Inbound messages that matched no messaging channel. A patient tapped a button and nobody is looking. Stays non-zero until the historical rows are resolved, so it will not clear by itself after a fix.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_inbound_unrouted",
          "instant": true,
          "legendFormat": "unrouted"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sends stuck mid-flight",
      "description": "Dispatches left ATTEMPTING past the reconciler's deadline — the worker died between contacting WhatsApp and recording the result. Some of these may have reached the patient.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_dispatch_attempting_overdue",
          "instant": true,
          "legendFormat": "stuck"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "3 is healthy: the app, Caddy and Prometheus itself. A drop here means the metric is missing because the scrape failed, not because the system is quiet — which is the distinction that matters when reading every other panel.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "red", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up)",
          "instant": true,
          "legendFormat": "up"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Time since each sweep last reported",
      "description": "A line that climbs and does not come back down is a sweep that has stopped. The heartbeat sweep is excluded: the one that watches the others cannot meaningfully watch itself.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_sweep_last_run_age_seconds{sweep!=\"heartbeat\"}",
          "legendFormat": "{{sweep}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Redis holds hints, not state, so a backlog is not data loss — but a waiting count that climbs means consumers are not keeping up, and sends are not going out. A failed count that never drains is where to look for provider rejections.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_queue_jobs{state=\"wait\"}",
          "legendFormat": "{{queue}} waiting"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_queue_jobs{state=\"delayed\"}",
          "legendFormat": "{{queue}} delayed"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_queue_jobs{state=\"failed\"}",
          "legendFormat": "{{queue}} failed"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Reminders rejected by WhatsApp",
      "description": "An expired access token and a rejected template look identical here — both are a wall of failures. /admin shows the provider error code for each, which is what tells them apart.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wasal_dispatch_failed_recent",
          "legendFormat": "failed in last {{window}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Application errors by route",
      "description": "Labelled by ROUTE FILE, not by URL. A label built from the requested path would create a time series per patient id and put patient identifiers into the time-series database.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (route_type, route_path) (rate(wasal_http_request_errors_total[5m]))",
          "legendFormat": "{{route_type}} {{route_path}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Edge latency (p95, measured at Caddy)",
      "description": "The app cannot measure its own request latency: Next 16 has no hook that sees a successful request end. Caddy terminates every request, so it measures the thing the application cannot — including requests that never reached it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "5xx responses at the edge",
      "description": "Caddy's request counter carries no status code, so this reads the duration histogram's _count series, which does. A sustained non-zero rate here means the app is failing requests faster than it recovers.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Node.js event loop lag",
      "description": "From collectDefaultMetrics. Sustained lag is what makes a healthy-looking process answer slowly, and it is the earliest sign that the box is short of memory rather than short of CPU.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"wasal-web\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Heap in use (web and worker)",
      "description": "Two processes, two lines. A climb that never comes back down after a GC is the shape of a leak; a sawtooth that touches the ceiling is the shape of too small a container.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_heap_size_used_bytes{job=\"wasal-web\"}",
          "legendFormat": "web heap used"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Alerts firing",
      "description": "Prometheus alert rules currently firing. There is no Alertmanager in this stack — this panel and http://localhost:9090/alerts are where a firing rule is seen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": { "color": "red", "index": 0 },
                      "warning": { "color": "orange", "index": 1 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{alertname}}"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Prometheus alerts",
      "type": "link",
      "url": "http://localhost:9090/alerts",
      "tooltip": "Localhost only — open this through the SSH tunnel."
    }
  ]
}
