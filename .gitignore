# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but not the templates. They contain no secrets, and the server deployment
# clones this repo and needs them as the setup checklist. Without these
# negations `.env*` silently swallows them, which is how `.env.example` went
# uncommitted for so long.
!.env.example
!.env.production.example

# The Prometheus scrape token. It is the only credential in front of
# /api/metrics, and it lives beside the compose file rather than in `.env`
# because Prometheus reads it via `credentials_file`. See docs/DEPLOY.md.
/deploy/monitoring/metrics_token

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
