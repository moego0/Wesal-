# ─────────────────────────────────────────────────────────────────────────────
# Wisal — production environment template.
#
# Copy to `.env` on the server and fill it in:
#
#   scp .env.production.example deploy-host:/opt/wasal/.env
#   ssh deploy-host 'chmod 600 /opt/wasal/.env'
#
# NEVER commit the real `.env`. `.gitignore` already covers `.env*`, and this
# file exists only to be the checklist.
#
# The same file is read twice by docker-compose.prod.yml: as `env_file:` for the
# containers, and as the source for `${...}` interpolation. That is why the
# Postgres credentials below appear both on their own and inside DATABASE_URL —
# compose substitutes them, the app does not.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER="wasal"
# Generate: openssl rand -hex 24
# Keep it HEX specifically. This password is interpolated into DATABASE_URL, and
# a character that needs percent-encoding there produces a URL that parses into
# the wrong credentials — a confusing failure at 3am.
POSTGRES_PASSWORD="REPLACE_ME_openssl_rand_hex_24"
POSTGRES_DB="wasal"

# Host is the compose service name, not localhost: the app runs in its own
# container. Port 5432 is NOT published to the host on purpose.
DATABASE_URL="postgresql://wasal:REPLACE_ME_SAME_HEX_AS_ABOVE@postgres:5432/wasal?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Compose service name again. Not published to the host.
REDIS_URL="redis://redis:6379"

# ─── App ─────────────────────────────────────────────────────────────────────
# Signs session cookies. Required even though it is not used on every path;
# the app refuses to boot without it. It must be at least 32 characters and must
# not begin with "change-me".
# Generate: openssl rand -hex 32
SESSION_SECRET="REPLACE_ME_openssl_rand_hex_32"

# Public origin. Must match the Caddy address exactly, scheme included —
# absolute URLs in messages and the webhook docs are built from it.
APP_URL="https://CHANGEME.duckdns.org"

# Refuse to boot if any of the production settings below are missing or still
# placeholders. Leave this at 1 for real deployments: it converts a
# misconfiguration into a startup failure rather than a silent misbehaviour when
# the first reminder is due. It also makes a failed migration fatal at boot
# instead of a warning.
REQUIRE_PRODUCTION_CONFIG="1"

# ─── Edge / TLS ──────────────────────────────────────────────────────────────
# The hostname Caddy serves and requests a certificate for. Must resolve to this
# VM's RESERVED public IP.
#   DuckDNS  ->  yourname.duckdns.org
#   sslip.io ->  203-0-113-10.sslip.io   (dashes, and use your real IP)
WISAL_DOMAIN="CHANGEME.duckdns.org"

# Contact address for Let's Encrypt expiry notices. Optional, but an empty
# value is a Caddyfile syntax error, so either set it or delete the `email` line
# from deploy/Caddyfile.
ACME_EMAIL="you@example.com"

# ─── Messaging ───────────────────────────────────────────────────────────────
MESSAGING_PROVIDER="whatsapp_cloud"

# Meta app secret. Verifies the X-Hub-Signature-256 HMAC on inbound webhooks.
WHATSAPP_APP_SECRET="REPLACE_ME"
# A PERMANENT system-user token. The temporary one in the dashboard expires in
# 24 hours, which looks exactly like a deliverability outage when it lapses.
WHATSAPP_ACCESS_TOKEN="REPLACE_ME"
# The `phone_number_id`, NOT the display number. This value is also the inbound
# routing key — it must equal the `metadata.phone_number_id` Meta sends, and it
# must match the MessagingChannel row that scripts/bootstrap-prod.ts writes.
WHATSAPP_PHONE_NUMBER_ID="REPLACE_ME"
# Invented here; must be entered identically in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN="REPLACE_ME_invent_a_long_random_string"
WHATSAPP_API_VERSION="v21.0"
# Display number, +E.164. Cosmetic — shown in the app, never used for routing.
WHATSAPP_DISPLAY_PHONE_E164="+20XXXXXXXXXX"

# ─── Operations console and metrics ──────────────────────────────────────────
# The read-only ops console at /admin. Unset means OFF in production, which is
# the default; 1 turns it on. It is still gated to the pharmacy admin by
# permission, so this is not the only lock on the door.
ENABLE_ADMIN="1"

# Bearer token for /api/metrics, which Prometheus scrapes. This example sets it
# because the monitoring overlay is part of the deployment; without the overlay,
# leaving it empty makes the endpoint answer 404.
#
# Generate: openssl rand -hex 32
# The SAME value must be written to deploy/monitoring/metrics_token
# (gitignored, chmod 600) — Prometheus reads the token from that file because
# this one is interpolated by compose and visible to every container.
METRICS_TOKEN="REPLACE_ME_openssl_rand_hex_32"

# Grafana's admin password, required by docker-compose.monitoring.yml (compose
# refuses to start the stack without it — there is no admin/admin fallback).
# Generate: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD="REPLACE_ME_openssl_rand_hex_24"

# Each of these is read once at process start (env() is memoised). Changing one
# takes `docker compose up -d`, not a reload.

# ─── Scheduling ──────────────────────────────────────────────────────────────
# How far ahead reminder events are materialized. Must comfortably exceed the
# longest expected worker outage, or an outage silently leaves a gap.
MATERIALIZE_HORIZON_HOURS="72"

# ─── First-run data ──────────────────────────────────────────────────────────
# MUST stay 0 in production. At 1 the worker seeds an empty database with the
# DEMO dataset, which deletes every row and creates the public logins printed in
# the README. The real first-run setup is scripts/bootstrap-prod.ts.
AUTO_SEED_DEMO="0"

# ─── Bootstrap (read only by scripts/bootstrap-prod.ts) ──────────────────────
# The pharmacy row to create. Must match nothing already present, or the
# existing row is adopted.
PHARMACY_NAME="صيدلية النور"
PHARMACY_TIMEZONE="Africa/Cairo"
PHARMACY_QUIET_START="21:30"
PHARMACY_QUIET_END="07:00"

# The admin user. ADMIN_PASSWORD may be omitted, in which case the bootstrap
# generates one and prints it exactly once — only the hash is stored, so a
# generated password that is not captured is gone for good.
ADMIN_EMAIL="owner@yourpharmacy.example"
ADMIN_NAME="Pharmacy Admin"
ADMIN_PHONE_E164="+20XXXXXXXXXX"
# ADMIN_PASSWORD=""
