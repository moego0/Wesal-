# ─────────────────────────────────────────────────────────────────────────────
# Wisal — environment template. Copy to `.env` and fill in.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Port 5433 matches docker-compose.yml (chosen to avoid clashing
# with a locally-installed Postgres on 5432).
DATABASE_URL="postgresql://wasal:wasal_dev_password@localhost:5433/wasal?schema=public"

# Redis. Port 6380 matches docker-compose.yml.
REDIS_URL="redis://localhost:6380"

# Session cookie signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-64-char-hex-string-before-any-real-use"

# Web app origin, used for absolute URLs in messages and webhook docs.
APP_URL="http://localhost:3000"

# ─── Messaging ───────────────────────────────────────────────────────────────
# Which provider implementation to load.
#   mock          — local only. Logs sends to the dev outbox at /api/dev/outbox.
#                   NO real messages.
#   whatsapp_cloud — Meta WhatsApp Business Cloud API. Requires everything below.
MESSAGING_PROVIDER="mock"

# Meta WhatsApp Cloud API credentials. Leave blank while MESSAGING_PROVIDER=mock.
# Meta app secret — used to verify the X-Hub-Signature-256 HMAC on webhooks.
WHATSAPP_APP_SECRET=""
# Permanent system-user access token for the WhatsApp Business Account.
WHATSAPP_ACCESS_TOKEN=""
# The `phone_number_id` (NOT the display phone number) that sends messages.
# Also the key used to route an inbound webhook to the right pharmacy.
WHATSAPP_PHONE_NUMBER_ID=""
# Arbitrary string you invent; Meta echoes it back on the webhook verification
# GET request. Must match what you enter in the Meta app dashboard.
WHATSAPP_VERIFY_TOKEN=""
# Graph API version to pin. Never use an unpinned/`latest` version.
WHATSAPP_API_VERSION="v21.0"

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Reminders are materialized ahead of time on this horizon.
# Shorter = smaller reconciliation on schedule edits, and stale tzdata ages out
# faster. Must comfortably exceed the longest expected worker outage.
MATERIALIZE_HORIZON_HOURS="72"

# Set to "1" in production to refuse to start when placeholder secrets are
# still in place.
REQUIRE_PRODUCTION_CONFIG="0"

# ─── First-run data ──────────────────────────────────────────────────────────
# Whether the worker may populate an EMPTY database with the synthetic demo data
# in prisma/seed.ts. That seed deletes every row and creates the demo logins
# documented in the README, so it must never run against production.
#
# Leave this commented out to get the safe default: ON when NODE_ENV is not
# "production", OFF when it is. Set it explicitly to override.
# AUTO_SEED_DEMO="1"
