# ==============================================================================
# Wesal (وِصال) Platform Configuration & Environment Variables
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-wesal-production-secret-change-me-2026
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.wesal.care
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.wesal.care
TIME_ZONE=Africa/Cairo

# Database (PostgreSQL for production; falls back to SQLite if empty)
DATABASE_URL=postgres://wesal_user:secure_password_here@localhost:5432/wesal_db

# Celery / Redis Job Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=jwt-insecure-wesal-secret-production-change-me-2026
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# Meta WhatsApp Business Platform Cloud API Credentials
# ------------------------------------------------------------------------------
# Obtain from https://developers.facebook.com/apps/ > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=EAAB...your_system_user_permanent_token_here...
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000002

# Webhook Verification Token (set this same secret in Meta App Dashboard)
WHATSAPP_VERIFY_TOKEN=wesal_webhook_verify_token_2026

# Meta App Secret (used for HMAC SHA-256 Webhook payload signature validation)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version
WHATSAPP_API_VERSION=v21.0

# WhatsApp Message Template Configuration
WHATSAPP_DEFAULT_TEMPLATE_NAME=wesal_medication_reminder
WHATSAPP_DEFAULT_LANGUAGE_CODE=ar

# Mock Mode (Set to True for offline/local testing without active Meta credentials)
WHATSAPP_MOCK_MODE=False

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
